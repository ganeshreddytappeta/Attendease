// This is your Prisma schema file.
// Learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
}

// ─── Enums ────────────────────────────────────────────────────────────────────

enum Role {
  student
  faculty
  hod
  admin
}

enum RequestStatus {
  pending
  approved
  rejected
  cancelled
}

enum RequestReason {
  internship
  startup
  project_development
  medical
  sports
  family_emergency
  competition
  other
}

enum ActivityCategory {
  internship
  startup
  project_work
  sports
  house_events
}

enum ExamType {
  MID
  SEM
  LAB
  SUPPLEMENTARY
}

enum AnnouncementType {
  WIDGET
  OPENING_ANIMATION
  BANNER
}

enum AnnouncementState {
  DRAFT
  ACTIVE
  INACTIVE
}

enum AnnouncementMediaType {
  IFRAME
  VIDEO
  IMAGE
  LOTTIE
  TEXT
}

enum AnnouncementPlacement {
  HOME_TOP
  HOME_MIDDLE
  HOME_BOTTOM
  POPUP
}

enum AnnouncementDisplayMode {
  EVERY_PAGE_LOAD
  ONCE_PER_SESSION
  ONCE_PER_DAY
  ONCE_PER_LOGIN
  ONCE_PER_USER
}

// ─── Models ───────────────────────────────────────────────────────────────────

model User {
  id          String   @id @default(cuid())
  userId      String   @unique          // human-readable: "stu-001", "fac-csit-001"
  name        String
  email       String   @unique
  role        Role
  department  String
  password    String
  rollNumber  String?
  year        String?
  section     String?
  semester    Int?
  avatarUrl   String?
  designation String?
  phone       String?
  fcmToken    String?
  isActive    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  counselorId           String?
  counselor             User?                  @relation("FacultyCounselees", fields: [counselorId], references: [userId], onDelete: SetNull)
  counselees            User[]                 @relation("FacultyCounselees")

  // Relations
  submittedRequests        Request[]                    @relation("StudentRequests")
  primaryRequests          Request[]                    @relation("PrimaryFacultyRequests")
  assignedRequests         RequestFaculty[]
  performedActions         RequestAction[]
  notifications            Notification[]
  passkeys                 UserPasskey[]
  attendanceSubmissions    AttendanceSubmission[]
  createdShareLinks        PermissionRequestShareLink[] @relation("UserCreatedShareLinks")
  invigilationAssignments  InvigilationAssignment[]
  studentActivities        StudentActivity[]            @relation("StudentActivities")
  coordinatorAccesses      CoordinatorAccess[]          @relation("FacultyCoordinatorAccess")
  assignedCoordinators     CoordinatorAccess[]          @relation("AdminAssignedCoordinators")
  assignedActivities       StudentActivity[]            @relation("CoordinatorAssignedActivities")

  // Certificate relations
  certificateRequests      CertificateRequest[]         @relation("StudentCertificateRequests")
  requestedCertificates    CertificateRequest[]         @relation("StudentCertificateRequestors")
  coordinatedCertReqs      CertificateRequest[]         @relation("CoordinatorCertificateActions")
  issuedCertificates       IssuedCertificate[]          @relation("StudentIssuedCertificates")
  coordinatedCertificates  IssuedCertificate[]          @relation("CoordinatorIssuedCertificates")

  @@index([role])
  @@index([department])
  @@index([rollNumber])
  @@index([counselorId])
}

model Request {
  id                  String        @id @default(cuid())
  requestId           String        @unique  // human-readable: "req-LK4F2J-A3BX"
  publicId            String?       @unique  // secure public identifier: "rq_U2YQ7XkP9WmL3nA8"
  studentId           String                 // references User.userId
  primaryFacultyId    String?                // references User.userId (primary reviewer)

  reason              RequestReason
  reasonLabel         String
  date                String
  endDate             String?
  periods             String?
  grantedPeriods      String?
  startTime           String
  endTime             String
  description         String
  documentName        String?
  documentUrl         String?
  status              RequestStatus @default(pending)
  rejectionReason     String?
  submittedAt         String
  reviewedAt          String?

  finalDecisionBy     String?       // "Faculty" | "HOD"
  finalDecisionUserId String?       // references User.userId

  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relations
  student             User          @relation("StudentRequests", fields: [studentId], references: [userId])
  primaryFaculty      User?         @relation("PrimaryFacultyRequests", fields: [primaryFacultyId], references: [userId])
  faculties           RequestFaculty[]
  actions             RequestAction[]
  notifications       Notification[]
  shareLinks          PermissionRequestShareLink[]

  @@index([studentId])
  @@index([status])
  @@index([submittedAt(sort: Desc)])
  @@index([primaryFacultyId])
  @@index([publicId])
}

/// Dedicated secure share link for attendance permission requests
model PermissionRequestShareLink {
  id             String    @id @default(cuid())
  requestId      String    // references Request.id
  token          String    @unique // cryptographically secure token: "8F4K2P9X7M"
  createdBy      String    // references User.userId
  createdAt      DateTime  @default(now())
  expiresAt      DateTime?
  revokedAt      DateTime?
  isActive       Boolean   @default(true)
  lastAccessedAt DateTime?

  request        Request   @relation(fields: [requestId], references: [id], onDelete: Cascade)
  creator        User      @relation("UserCreatedShareLinks", fields: [createdBy], references: [userId], onDelete: Cascade)

  @@index([requestId])
  @@index([token])
  @@index([createdBy])
  @@index([isActive])
  @@map("permission_request_share_links")
}

/// Join table: which faculty members are assigned to review a request
model RequestFaculty {
  requestId  String
  facultyId  String   // references User.userId

  request    Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  faculty    User     @relation(fields: [facultyId], references: [userId])

  @@id([requestId, facultyId])
  @@index([facultyId])
}

/// Audit trail: records every action performed on a request
model RequestAction {
  id            String   @id @default(cuid())
  requestId     String   // references Request.id
  performedById String   // references User.userId
  action        String   // "Submitted", "Approved by Faculty", "Rejected by Faculty", "Approved by HOD", "Rejected by HOD", "Overridden by HOD", "Cancelled"
  remarks       String?
  performedAt   DateTime @default(now())

  request       Request  @relation(fields: [requestId], references: [id], onDelete: Cascade)
  performedBy   User     @relation(fields: [performedById], references: [userId])

  @@index([requestId])
  @@index([performedById])
}

/// Real-time notifications for users
model Notification {
  id        String   @id @default(cuid())
  userId    String   // Target recipient (User.userId)
  requestId String?
  type      String   // "approved", "rejected", "pending", "cancelled", "override"
  title     String
  message   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())

  user      User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  request   Request? @relation(fields: [requestId], references: [id], onDelete: SetNull)

  @@index([userId])
}

/// Registered WebAuthn Passkeys for multi-device biometrics
model UserPasskey {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
  credentialId String   @unique
  publicKey    String   @db.Text
  counter      Int      @default(0)
  deviceName   String?
  createdAt    DateTime @default(now())
  lastUsedAt   DateTime @default(now())

  @@index([userId])
}

/// Section attendance submissions made by faculty for specific period blocks
model AttendanceSubmission {
  id           String             @id @default(cuid())
  date         String             // YYYY-MM-DD
  section      String             // e.g. "CSIT-B"
  year         String             @default("3rd Year") // e.g. "3rd Year"
  periods      String             // Comma-separated period numbers e.g. "1,2"
  periodLabel  String             // e.g. "Periods 1 & 2 (9:00 AM - 10:30 AM)"
  markedById   String             // User.userId (faculty)
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  markedBy     User               @relation(fields: [markedById], references: [userId])
  records      AttendanceRecord[]

  @@unique([date, section, year, periods])
  @@index([date, section])
  @@index([date, section, year])
  @@index([markedById])
}

/// Student roll number status for an attendance submission
model AttendanceRecord {
  id           String               @id @default(cuid())
  submissionId String
  rollNumber   String               // e.g. "73", "D1", "LE12"
  status       String               // "present" | "absent"

  submission   AttendanceSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@unique([submissionId, rollNumber])
}

// ─── Invigilation Management ──────────────────────────────────────────────────

enum SessionType {
  MORNING
  AFTERNOON
}

/// Invigilation exam session created by admin
model InvigilationDuty {
  id          String                    @id @default(cuid())
  examType    ExamType                  // MID or SEM (existing enum)
  date        String                    // YYYY-MM-DD (Asia/Kolkata calendar date)
  session     SessionType               // MORNING | AFTERNOON
  startTime   String?                   // Optional HH:mm (24h) local IST time, e.g. "09:30"
  endTime     String?                   // Optional HH:mm (24h) local IST time, e.g. "12:30"
  createdAt   DateTime                  @default(now())
  updatedAt   DateTime                  @updatedAt

  assignments InvigilationAssignment[]

  @@index([date])
  @@index([examType, session])
}

/// Faculty member assigned to an invigilation duty
model InvigilationAssignment {
  id         String            @id @default(cuid())
  dutyId     String
  facultyId  String            // references User.id (cuid primary key)
  createdAt  DateTime          @default(now())
  updatedAt  DateTime          @updatedAt

  duty       InvigilationDuty  @relation(fields: [dutyId], references: [id], onDelete: Cascade)
  faculty    User              @relation(fields: [facultyId], references: [id], onDelete: Restrict)

  @@unique([dutyId, facultyId])
  @@index([facultyId])
  @@index([dutyId])
}

// ─── Student Activities & Coordinator Authorization ────────────────────────────

/// Student participation record in an extra-curricular activity
model StudentActivity {
  id                  String           @id @default(cuid())
  studentId           String           // references User.userId
  category            ActivityCategory
  titleOrCompany      String           // Company name, Startup name, Project title, Sport name, or House event
  roleOrPosition      String?          // Role/Position, Area, Level, or Event role
  mentorOrAchievement String?          // Faculty mentor, achievement details, or notes
  startDate           String?          // YYYY-MM-DD
  endDate             String?          // YYYY-MM-DD
  status              String           @default("active") // "active" | "completed" | "archived"
  isActive            Boolean          @default(true) // Soft deletion
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  student              User               @relation("StudentActivities", fields: [studentId], references: [userId], onDelete: Cascade)
  coordinatorId        String?            // references User.userId (assigned coordinator)
  assignedCoordinator  User?              @relation("CoordinatorAssignedActivities", fields: [coordinatorId], references: [userId])
  certificateRequests  CertificateRequest[]

  @@index([studentId])
  @@index([coordinatorId])
  @@index([category])
  @@index([isActive])
  @@index([category, isActive])
  @@map("student_activities")
}

/// Faculty Coordinator assignment with secure authorization code
model CoordinatorAccess {
  id           String           @id @default(cuid())
  facultyId    String           // references User.userId
  category     ActivityCategory
  codeHash     String           // One-way hash of coordinator code
  codeMasked   String           // Masked display e.g. "COORD-****-89AB"
  isActive     Boolean          @default(true)
  assignedById String           // references User.userId (admin)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  faculty      User             @relation("FacultyCoordinatorAccess", fields: [facultyId], references: [userId], onDelete: Cascade)
  assignedBy   User             @relation("AdminAssignedCoordinators", fields: [assignedById], references: [userId])

  @@unique([facultyId, category])
  @@index([facultyId])
  @@index([category])
  @@index([isActive])
  @@map("coordinator_access")
}

/// Audit log for coordinator and admin activity management operations
model ActivityAuditLog {
  id          String   @id @default(cuid())
  actorId     String   // references User.userId
  actorName   String
  actorRole   String
  action      String   // "ADD" | "EDIT" | "REMOVE" | "BULK_ADD" | "BULK_REMOVE" | "COORDINATOR_ASSIGNED" | "CODE_REGENERATED" | "ACCESS_TOGGLED"
  category    String
  studentId   String?
  studentName String?
  details     String?  // JSON string containing change details
  timestamp   DateTime @default(now())

  @@index([category])
  @@index([actorId])
  @@index([timestamp(sort: Desc)])
  @@map("activity_audit_logs")
}

/// Production-grade dynamic Announcement, Widget, and Opening Animation model
model AnnouncementWidget {
  id                String                  @id @default(cuid())
  title             String
  type              AnnouncementType
  mediaType         AnnouncementMediaType
  state             AnnouncementState       @default(DRAFT)
  placement         AnnouncementPlacement   @default(HOME_TOP)

  srcUrl            String?
  externalUrl       String?

  content           String?

  buttonText        String?
  buttonUrl         String?
  openInNewTab      Boolean                 @default(true)

  displayOrder      Int                     @default(0)
  priority          Int                     @default(0)

  targetRoles       String[]                @default(["student"])
  targetYears       String[]                @default([])
  targetDepartments String[]                @default([])
  targetSections    String[]                @default([])

  startsAt          DateTime?
  endsAt            DateTime?

  displayMode       AnnouncementDisplayMode @default(ONCE_PER_SESSION)

  closable          Boolean                 @default(true)
  showCloseButton   Boolean                 @default(true)
  autoCloseSeconds  Int?
  backdropDismiss   Boolean                 @default(true)

  height            Int?
  width             Int?
  mobileHeight      Int?
  desktopHeight     Int?
  aspectRatio       String?
  fullWidth         Boolean                 @default(false)

  createdById       String?
  updatedById       String?

  createdAt         DateTime                @default(now())
  updatedAt         DateTime                @updatedAt

  views             AnnouncementView[]      @relation("AnnouncementViews")

  @@index([state, startsAt, endsAt])
  @@index([state, placement, displayOrder])
  @@index([type, state])
  @@index([priority])
  @@map("announcement_widgets")
}

// ─── Certificate Generation ───────────────────────────────────────────────────

enum CertificateRequestStatus {
  pending    // Awaiting coordinator review
  approved   // Certificate issued
  rejected   // Coordinator declined
  revoked    // Previously issued certificate revoked by coordinator
}

enum CertificateTenure {
  completed // Activity has ended; endDate is the actual end date
  active    // Activity still ongoing; endDate is the application date
}

/// A student's request for a participation certificate linked to one StudentActivity
model CertificateRequest {
  id                  String                    @id @default(cuid())
  activityId          String                    // references StudentActivity.id
  studentId           String                    // references User.userId (student)
  requestedById       String                    // references User.userId (student — same as studentId)
  coordinatorId       String?                   // references User.userId (coordinator who acts on it)

  tenure              CertificateTenure
  /// Effective start date copied at request time (YYYY-MM-DD)
  capturedStartDate   String?
  /// Effective end date copied at request time (YYYY-MM-DD); equals application date for active tenure
  capturedEndDate     String?

  status              CertificateRequestStatus  @default(pending)
  studentRemarks      String?                   // Optional note from student at submission
  coordinatorRemarks  String?                   // Coordinator note at approval/rejection

  requestDate         String?                   // Asia/Kolkata calendar day (YYYY-MM-DD)
  requestedAt         DateTime                  @default(now())
  reviewedAt          DateTime?

  activity            StudentActivity           @relation(fields: [activityId], references: [id], onDelete: Restrict)
  student             User                      @relation("StudentCertificateRequests",  fields: [studentId],      references: [userId])
  requestedBy         User                      @relation("StudentCertificateRequestors", fields: [requestedById], references: [userId])
  coordinator         User?                     @relation("CoordinatorCertificateActions", fields: [coordinatorId], references: [userId])
  certificate         IssuedCertificate?

  /// Prevents duplicate requests for the same activity on the same IST day at the database level.
  @@unique([studentId, activityId, requestDate])
  @@index([activityId])
  @@index([studentId])
  @@index([status])
  @@index([requestedAt(sort: Desc)])
  @@map("certificate_requests")
}

/// Immutable certificate snapshot created atomically when a coordinator approves a request.
/// One IssuedCertificate per approved CertificateRequest; revocation sets revokedAt rather
/// than deleting the record, preserving the audit trail.
model IssuedCertificate {
  id                    String              @id @default(cuid())
  certificateRequestId  String              @unique  // references CertificateRequest.id
  activityId            String              // references StudentActivity.id
  certificateNumber     String              @unique  // human-readable: "CERT-INT-2024-0042"

  // ── Immutable student snapshot ──────────────────────────────────────────────
  studentId             String              // references User.userId
  studentName           String
  studentRollNumber     String?
  studentDepartment     String
  studentYear           String?
  studentSection        String?

  // ── Immutable activity snapshot ─────────────────────────────────────────────
  category              String
  titleOrCompany        String
  roleOrPosition        String?
  tenure                CertificateTenure
  effectiveStartDate    String?             // YYYY-MM-DD
  effectiveEndDate      String?             // YYYY-MM-DD

  // ── Institutional verification block (NOT a digital signature) ──────────────
  issuedByCoordinatorId   String            // references User.userId
  issuedByName            String
  issuedByDesignation     String?
  issuedByDepartment      String
  issuedAt                DateTime          @default(now())

  /// A stable, opaque token for the public verification URL (not a crypto signature)
  verificationToken       String            @unique @default(cuid())

  revokedAt               DateTime?
  revokedById             String?           // references User.userId
  revocationReason        String?

  certificateRequest    CertificateRequest  @relation(fields: [certificateRequestId], references: [id], onDelete: Restrict)
  student               User               @relation("StudentIssuedCertificates",      fields: [studentId],              references: [userId])
  issuedByCoordinator   User               @relation("CoordinatorIssuedCertificates",  fields: [issuedByCoordinatorId],  references: [userId])

  @@index([activityId])
  @@index([studentId])
  @@index([verificationToken])
  @@index([issuedAt(sort: Desc)])
  @@map("issued_certificates")
}

/// Lightweight interaction & frequency tracker per user
model AnnouncementView {
  id             String             @id @default(cuid())
  announcementId String
  userId         String
  viewedAt       DateTime           @default(now())
  dismissedAt    DateTime?
  clickedAt      DateTime?

  announcement   AnnouncementWidget @relation("AnnouncementViews", fields: [announcementId], references: [id], onDelete: Cascade)

  @@unique([announcementId, userId])
  @@index([userId])
  @@index([announcementId])
  @@map("announcement_views")
}
